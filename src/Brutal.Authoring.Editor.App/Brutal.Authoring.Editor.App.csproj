<Project Sdk="Microsoft.NET.Sdk">
  <!-- The interactive host: opens a real window (GLFW), sets up Vulkan and draws the ImGui editor in it with BRUTAL's
       ImGui backends. BORROWED from the author's own BRUTAL game client (its renderer's device, swapchain and frame loop, its tools overlay's
       ImGui setup), cut down to what an editor needs: no meshes, shaders or depth. Tests never reference this; they use
       the headless host in Brutal.Authoring.Editor.ImGui, so no window opens on a test run. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Brutal.Authoring.Editor.ImGui\Brutal.Authoring.Editor.ImGui.csproj" />
    <ProjectReference Include="..\Brutal.Authoring.Import\Brutal.Authoring.Import.csproj" />
    <PackageReference Include="Ahwoo.Brutal.Stb" />
    <PackageReference Include="Ahwoo.Brutal.Core" />
    <PackageReference Include="Ahwoo.Brutal.Glfw" />
    <PackageReference Include="Ahwoo.Brutal.Vulkan" />
    <PackageReference Include="Ahwoo.Brutal.Vulkan.Abstractions" />
    <PackageReference Include="Ahwoo.Brutal.ImGui" />
    <PackageReference Include="Ahwoo.Brutal.ImGui.Backends" />
    <PackageReference Include="Ahwoo.Brutal.OpenGl" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../tools/SceneShaderCompiler/SceneShaderCompiler.csproj" ReferenceOutputAssembly="false" Private="false" PrivateAssets="all" />
    <EmbeddedResource Include="$(IntermediateOutputPath)scene.vert.spv" LogicalName="BED.Scene.vert.spv" />
    <EmbeddedResource Include="$(IntermediateOutputPath)scene.frag.spv" LogicalName="BED.Scene.frag.spv" />
    <EmbeddedResource Include="$(IntermediateOutputPath)scene-textured.frag.spv" LogicalName="BED.Scene.textured.frag.spv" />
  </ItemGroup>
  <Target Name="CompileSceneShaders" BeforeTargets="PrepareResources" DependsOnTargets="ResolveProjectReferences"
          Inputs="Shaders/scene.vert;Shaders/scene.frag;Shaders/scene-textured.frag;../../tools/SceneShaderCompiler/Program.cs"
          Outputs="$(IntermediateOutputPath)scene.vert.spv;$(IntermediateOutputPath)scene.frag.spv;$(IntermediateOutputPath)scene-textured.frag.spv">
    <PropertyGroup>
      <SceneDotnetHost Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</SceneDotnetHost>
      <SceneDotnetHost Condition="'$(SceneDotnetHost)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">$(NetCoreRoot)dotnet.exe</SceneDotnetHost>
      <SceneDotnetHost Condition="'$(SceneDotnetHost)' == ''">$(NetCoreRoot)dotnet</SceneDotnetHost>
    </PropertyGroup>
    <Exec Command="&quot;$(SceneDotnetHost)&quot; &quot;$(MSBuildProjectDirectory)/../../tools/SceneShaderCompiler/bin/$(Configuration)/net10.0/SceneShaderCompiler.dll&quot; &quot;$(MSBuildProjectDirectory)/Shaders&quot; &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath).&quot;" />
  </Target>
  <ItemGroup>
    <!-- Explicit app-local native dependency: keep it beside single-file BED.exe, never load it from a project. -->
    <None Include="..\..\third_party\accesskit\0.23.2\accesskit.dll" Link="accesskit.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>



