<Project Sdk="Microsoft.NET.Sdk">
  <!-- brutal-authoring: the general app anyone can open (the user, 2026-11-01). It opens any project of JSON data and
       schemas with no code, remembers recent projects, and hosts the data workspace in a window. With shot it draws
       the same screens headless into a PNG instead, so it can be checked where no window may open. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>BED</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Brutal.Authoring.Editor.App\Brutal.Authoring.Editor.App.csproj" />
    <!-- The Text panel (with ImCode, MIT), which the app adds to every data file (Program.SetUp). -->
    <ProjectReference Include="..\Brutal.Authoring.Editor.Text\Brutal.Authoring.Editor.Text.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The sample project a newcomer is offered on the start screen, copied next to the program. -->
    <None Include="..\..\samples\StarterProject\**\*" LinkBase="samples/recipes" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="..\..\build\Notices.targets" />
  <ItemGroup>
    <ProjectReference Include="../../samples/SceneStarter/SceneStarter.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../samples/SceneStarterAdapter/SceneStarterAdapter.csproj" ReferenceOutputAssembly="false" />
    <None Include="../../samples/SceneStarterProject/**/*" LinkBase="samples/scene-starter" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopySceneStarterLinkedSample" AfterTargets="Build">
    <ItemGroup>
      <SceneStarterRuntime Include="../../samples/SceneStarter/bin/$(Configuration)/net10.0/SceneStarter.exe;../../samples/SceneStarter/bin/$(Configuration)/net10.0/SceneStarter.dll;../../samples/SceneStarter/bin/$(Configuration)/net10.0/SceneStarter.deps.json;../../samples/SceneStarter/bin/$(Configuration)/net10.0/SceneStarter.runtimeconfig.json;../../samples/SceneStarter/bin/$(Configuration)/net10.0/Brutal.Authoring.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SceneStarterRuntime)" DestinationFolder="$(OutDir)samples/SceneStarter" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../../samples/SceneStarterAdapter/bin/$(Configuration)/net10.0/SceneStarterAdapter.dll" DestinationFolder="$(OutDir)adapters" SkipUnchangedFiles="true" />
  </Target></Project>
