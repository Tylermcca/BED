<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Text panel: a data file's JSON as text, on ImCode (MIT, aproposmath), vendored at a pinned commit
       (third_party/ImCode/PINNED.md). Its own package, so the core editor (Brutal.Authoring.Editor.ImGui) carries no
       third-party code: a host opts in with DataWorkspace.AddTextPanel(). ImCode isn't on NuGet, so it ships inside this
       package (lib/net10.0/ImCode.dll and ImCode.Text.dll), with its licence (licenses/ImCode-LICENSE.txt) and a notice
       naming it (THIRD-PARTY-NOTICES.txt), rather than as a package dependency. BRUTAL's analyzer applies here. -->
  <PropertyGroup>
    <Description>The Text panel for Brutal.Authoring's data editor: a data file's JSON as text, applied as one undoable edit. Includes ImCode (MIT, Copyright (c) 2026 aproposmath); see THIRD-PARTY-NOTICES.txt and licenses/ImCode-LICENSE.txt in the package.</Description>
    <!-- ImCode's DLLs go into lib/ beside this one (below). -->
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeImCodeInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Brutal.Authoring.Editor.ImGui\Brutal.Authoring.Editor.ImGui.csproj" />
    <PackageReference Include="Ahwoo.Brutal.Core" />
    <PackageReference Include="Ahwoo.Brutal.ImGui" />
    <!-- Private: built and copied, but not a package dependency, since ImCode has no package of its own. -->
    <ProjectReference Include="..\..\third_party\ImCode\src\ImCode\ImCode.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\third_party\ImCode\src\ImCode.Text\ImCode.Text.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <Target Name="IncludeImCodeInPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)" Condition="('%(ReferenceCopyLocalPaths.Filename)' == 'ImCode' Or '%(ReferenceCopyLocalPaths.Filename)' == 'ImCode.Text') And '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
    </ItemGroup>
  </Target>

  <!-- ImCode's LICENSE has no extension, so it's packed under the name a release uses (package_release.py). -->
  <Target Name="IncludeImCodeLicence" BeforeTargets="_GetPackageFiles">
    <Copy SourceFiles="..\..\third_party\ImCode\LICENSE" DestinationFiles="$(IntermediateOutputPath)ImCode-LICENSE.txt" SkipUnchangedFiles="true" />
    <ItemGroup>
      <None Include="$(IntermediateOutputPath)ImCode-LICENSE.txt" Pack="true" PackagePath="licenses" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
