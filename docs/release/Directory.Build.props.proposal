<Project>
  <!-- MIXED: role-separated assemblies from the architecture research, with SDK NuGet metadata.
       Working IDs and a local prerelease only. No publishing or runtime package is proposed here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
    <Deterministic>true</Deterministic>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1573</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Brutal.Authoring' Or '$(MSBuildProjectName)' == 'Brutal.Authoring.Data' Or '$(MSBuildProjectName)' == 'Brutal.Authoring.Editor' Or '$(MSBuildProjectName)' == 'Brutal.Authoring.Import' Or '$(MSBuildProjectName)' == 'Brutal.Authoring.Agent' Or '$(MSBuildProjectName)' == 'Brutal.Authoring.Editor.ImGui' Or '$(MSBuildProjectName)' == 'Brutal.Authoring.Editor.Text'">
    <IsPackable>true</IsPackable>
    <PackageId>$(MSBuildProjectName)</PackageId>
    <Version Condition="'$(Version)' == ''">0.0.0-local.a194</Version>
    <Authors>Tyler McCauley</Authors>
    <Copyright>Copyright (c) 2026 Tyler McCauley</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://example.invalid/REPLACE-REPOSITORY</RepositoryUrl>
    <RepositoryBranch>REPLACE-BRANCH</RepositoryBranch>
    <RepositoryCommit>REPLACE-COMMIT</RepositoryCommit>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <Description>Development-only authoring library for validated, undoable editing. Working package name; dependencies keep their own licences.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Brutal.Authoring'"><Description>Authoring documents, validated commands, undo, serialization and asset identities; no renderer or external package.</Description></PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Brutal.Authoring.Data'"><Description>JSON documents, schemas, projects and checks for authoring tools; no UI dependency.</Description></PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Brutal.Authoring.Editor'"><Description>UI-independent authoring editor model, selection, commands and inspectors.</Description></PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Brutal.Authoring.Import'"><Description>glTF authoring import through SharpGLTF.Core, under its separate MIT terms.</Description></PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Brutal.Authoring.Agent'"><Description>Typed authoring sessions and MCP protocol over data and editor models, without a UI host.</Description></PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Brutal.Authoring.Editor.ImGui' Or '$(MSBuildProjectName)' == 'Brutal.Authoring.Editor.Text'">
    <Description>Optional authoring editor panel using BRUTAL under BRUTAL License v1.0. Distributed hosts must meet its credits, logo and notice conditions; see README.md and licenses.</Description>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <!-- A reviewed generic PACKAGE-README.md is required at the root; do not substitute the internal root README. -->
    <None Include="$(MSBuildThisFileDirectory)PACKAGE-README.md" Pack="true" PackagePath="README.md" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE.txt" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
  <!-- BORROWED: the existing Notices.targets resolves terms from the actual restored asset folders.
       Pack terms with the libraries; deployment and graphical attribution remain the host's duty. -->
  <Target Name="PackBrutalTerms" BeforeTargets="_GetPackageFiles" DependsOnTargets="ResolveReferences" Condition="'$(IsPackable)' == 'true' And ('$(MSBuildProjectName)' == 'Brutal.Authoring.Editor.ImGui' Or '$(MSBuildProjectName)' == 'Brutal.Authoring.Editor.Text')">
    <ItemGroup>
      <_TermsAsset Include="@(ReferencePath)" Condition="$([System.String]::Copy('%(ReferencePath.NuGetPackageId)').StartsWith('Ahwoo.Brutal.', System.StringComparison.OrdinalIgnoreCase))" />
      <_TermsRoot Include="$([MSBuild]::GetDirectoryNameOfFileAbove('%(_TermsAsset.RootDir)%(_TermsAsset.Directory)', '.nupkg.metadata'))"><Id>%(_TermsAsset.NuGetPackageId)</Id></_TermsRoot>
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_TermsRoot)"><Output TaskParameter="Filtered" ItemName="_TermsRootOnce" /></RemoveDuplicates>
    <ItemGroup>
      <_TermsFile Include="%(_TermsRootOnce.Identity)/LICENSE.txt;%(_TermsRootOnce.Identity)/NOTICE.txt;%(_TermsRootOnce.Identity)/LICENSES/**/*.txt"><TermsId>%(_TermsRootOnce.Id)</TermsId></_TermsFile>
      <None Include="@(_TermsFile)" Pack="true" PackagePath="licenses/%(_TermsFile.TermsId)/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
      <None Include="$(MSBuildThisFileDirectory)NOTICE.txt" Pack="true" PackagePath="" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
