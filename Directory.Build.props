<Project>
  <PropertyGroup>
    <!-- Provisional; the user chooses the public release version. -->
    <Company>BED</Company>
    <Product>BED</Product>
    <AssemblyTitle>BED</AssemblyTitle>
    <Version>0.3.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- Goal 9: the public library's public members are documented, or it doesn't build (TreatWarningsAsErrors makes CS1591 an error). Samples and tests are exempt. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- A member must be documented; describing only some of its parameters is allowed. -->
    <NoWarn>$(NoWarn);CS1573</NoWarn>
    <!-- BED ships as one single-file program, where Assembly.Location is empty: report such uses in every ordinary build, not only at release time. -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>
</Project>
