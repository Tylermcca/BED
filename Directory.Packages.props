<Project>
  <!-- Test packages at the versions our BRUTAL games use, and SharpGLTF for the importer. BRUTAL packages arrive with the first task that needs them, at the versions decision D3 sets. -->
  <ItemGroup>
    <!-- glTF reading (D4). MIT; net10.0 target with no dependencies (nuget.org, checked 2026-10-31, OSS-004). -->
    <PackageVersion Include="SharpGLTF.Core" Version="1.0.7" />
    <!-- Gum's own project loader and dependency walker, for reading Gum projects (Bed.Editor). MIT; the preview-7 release. Brings BrotliSharpLib, CsvHelper, SharpCompress and FlatRedBall.InterpolationCore (THIRD-PARTY-NOTICES.md); no rendering or native package. -->
    <PackageVersion Include="FlatRedBall.GumCommon" Version="2026.11.13.2-preview.7" />
    <!-- Gum's own checker, the one behind gumcli check: ProjectLoader, HeadlessErrorChecker and ErrorDocsRegistry (Bed.Editor).
         MIT, the same preview-7 build. Brings KernSmith, FreeType (native), SkiaSharp (through Gum.ImageDiff, which BED never calls),
         Newtonsoft.Json and an embedded bmfont.exe (THIRD-PARTY-NOTICES.md). -->
    <PackageVersion Include="Gum.ProjectServices" Version="2026.11.13.2-preview.7" />
    <!-- Gum's own expression reader for linked values (GumExpressionService), which gumcli check turns on so GUM0002 checks
         linked values written as sums or plain numbers too (Bed.Editor). MIT; the same preview-7 build. Brings Microsoft.CodeAnalysis.CSharp
         (Roslyn) (THIRD-PARTY-NOTICES.md). -->
    <PackageVersion Include="Gum.Expressions" Version="2026.11.13.2-preview.7" />
    <!-- Gum's own Skia drawing, for the live picture of a Gum screen (GumScreenPicture). MIT; the same preview-7 build as
         FlatRedBall.GumCommon. Brings Gum.SkiaSharp, SkiaSharp (+ native libSkiaSharp), HarfBuzzSharp (+ native) and
         Topten.RichTextKit (THIRD-PARTY-NOTICES.md). Drawn on the CPU, so it is the same on Vulkan and OpenGL. -->
    <PackageVersion Include="Gum.SkiaSharp.Standalone" Version="2026.11.13.2-preview.7" />
    <!-- BRUTAL, for the editor window only (D3: the line our BRUTAL games use, headless-testable). The core and the editor model take none. -->
    <PackageVersion Include="Ahwoo.Brutal.ShaderC" Version="2026.10.2" />
    <PackageVersion Include="Ahwoo.Brutal.OpenAl" Version="2026.10.2" />
    <PackageVersion Include="NVorbis" Version="0.10.5" />
    <PackageVersion Include="Ahwoo.Brutal.Stb" Version="2026.10.2" />
    <PackageVersion Include="Ahwoo.Brutal.Jolt" Version="2026.10.2" />
    <PackageVersion Include="Ahwoo.Brutal.Core" Version="2026.10.1" />
    <PackageVersion Include="Ahwoo.Brutal.ImGui" Version="2026.10.2" />
    <!-- The interactive editor host only (Bed.Editor.App): a GLFW window, Vulkan and ImGui's backends, at
         the versions our BRUTAL games use (D3). The library, the editor model and the headless ImGui host take none of these. -->
    <PackageVersion Include="Ahwoo.Brutal.Glfw" Version="2026.10.4" />
    <PackageVersion Include="Ahwoo.Brutal.Vulkan" Version="2026.10.2" />
    <PackageVersion Include="Ahwoo.Brutal.Vulkan.Abstractions" Version="2026.10.2" />
    <PackageVersion Include="Ahwoo.Brutal.ImGui.Backends" Version="2026.10.2" />
    <!-- OpenGL, the fallback for a PC with no Vulkan (the user's laptop, 2026-11-03): BRUTAL's own binding, its run-verified recipe 7.21. -->
    <PackageVersion Include="Ahwoo.Brutal.OpenGl" Version="2026.10.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
