<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><AssemblyName>SceneStarter</AssemblyName><DebugType>none</DebugType></PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/Brutal.Authoring/Brutal.Authoring.csproj" /><ProjectReference Include="../../src/Brutal.Authoring.Runtime/Brutal.Authoring.Runtime.csproj" /></ItemGroup>
  <ItemGroup>
    <None Update="scene.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../LICENSE.txt" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../NOTICE.txt" Link="NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Only runtime outputs enter this sample export; do not ship source/debug/documentation sidecars. -->
  <Target Name="ExcludeDevelopmentSidecars" AfterTargets="ComputeFilesToPublish">
    <ItemGroup><ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' or '%(Extension)' == '.xml'" /></ItemGroup>
  </Target>
</Project>
