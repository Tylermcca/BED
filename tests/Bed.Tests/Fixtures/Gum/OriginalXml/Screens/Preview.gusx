    </Variable>
    <Variable Type="int" Name="Alpha.Red" SetsValue="true">
      <Value xsi:type="xsd:int">200</Value>
    </Variable>
    <Variable Type="int" Name="Alpha.Green" SetsValue="true">
      <Value xsi:type="xsd:int">120</Value>
    </Variable>
    <Variable Type="int" Name="Alpha.Blue" SetsValue="true">
      <Value xsi:type="xsd:int">50</Value>
    </Variable>
    <Variable Type="int" Name="Alpha.Alpha" SetsValue="true">
      <Value xsi:type="xsd:int">128</Value>
