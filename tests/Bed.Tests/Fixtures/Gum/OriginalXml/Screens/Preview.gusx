    </Variable>
    <Variable Type="int" Name="Glass.Green" SetsValue="true">
      <Value xsi:type="xsd:int">120</Value>
    </Variable>
    <Variable Type="int" Name="Glass.Blue" SetsValue="true">
      <Value xsi:type="xsd:int">50</Value>
    </Variable>
    <Variable Type="int" Name="Glass.Alpha" SetsValue="true">
      <Value xsi:type="xsd:int">128</Value>
